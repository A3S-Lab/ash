{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/A3S-Lab/ash/blob/main/fuzz/evidence-schema.json",
  "title": "ASH fuzz run evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "target",
    "status",
    "source_commit",
    "workflow_run_id",
    "workflow_run_attempt",
    "started_utc",
    "finished_utc",
    "elapsed_milliseconds",
    "toolchain",
    "cargo_fuzz",
    "engine",
    "sanitizer",
    "seed",
    "command",
    "initial_corpus",
    "exit_code",
    "statistics",
    "corpus",
    "artifacts",
    "log_sha256"
  ],
  "properties": {
    "schema": { "const": 1 },
    "target": {
      "enum": [
        "ason_decode",
        "frame_decode",
        "update_metadata",
        "signed_update_metadata"
      ]
    },
    "status": { "enum": ["passed", "failed", "invalid-evidence"] },
    "source_commit": { "$ref": "#/$defs/sha1" },
    "workflow_run_id": { "$ref": "#/$defs/nullableDecimal" },
    "workflow_run_attempt": { "$ref": "#/$defs/nullableDecimal" },
    "started_utc": { "type": "string", "format": "date-time" },
    "finished_utc": { "type": "string", "format": "date-time" },
    "elapsed_milliseconds": { "type": "integer", "minimum": 0 },
    "toolchain": { "const": "nightly-2026-07-31" },
    "cargo_fuzz": { "const": "cargo-fuzz 0.13.2" },
    "engine": { "const": "libfuzzer" },
    "sanitizer": { "const": "address" },
    "seed": { "type": ["integer", "null"], "minimum": 0 },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_total_time_seconds",
        "max_input_bytes",
        "rss_limit_mb",
        "input_timeout_seconds"
      ],
      "properties": {
        "max_total_time_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "max_input_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "rss_limit_mb": { "type": "integer", "minimum": 128, "maximum": 32768 },
        "input_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 60 }
      }
    },
    "initial_corpus": { "$ref": "#/$defs/corpusShape" },
    "exit_code": { "type": "integer" },
    "statistics": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "corpus": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8192,
      "items": { "$ref": "#/$defs/file" }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 8192,
      "items": { "$ref": "#/$defs/file" }
    },
    "log_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableDecimal": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[1-9][0-9]*$" }
      ]
    },
    "corpusShape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "bytes"],
      "properties": {
        "files": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 134217728 }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
